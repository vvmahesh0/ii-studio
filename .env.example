# Copy to .env.local. Do not paste credentials into chat or commit them.
# Choose antigravity, codex, claude, or gemini. Restart after editing defaults.
II_CLI_PROVIDER=antigravity
# Optional model ID supported by the selected CLI. Empty uses its default
# (Antigravity retains gemini-3.8-flash-low when empty).
II_MODEL=
# Optional ABSOLUTE executable paths. Otherwise use ~/.local/bin and PATH.
II_ANTIGRAVITY_PATH=
II_CODEX_PATH=
II_CLAUDE_PATH=
II_GEMINI_PATH=
# Authenticate with the chosen CLI's own login command, outside II studio.
# No OpenRouter key, Upstash database, Vercel account or studio subscription.
